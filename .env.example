# 이 파일을 .env 로 복사해 값을 채운다. 실제 키가 든 .env 는 커밋하지 않는다.

# LLM 백엔드: fake | openai | ollama (run.sh 가 검사 후 server.py 로 넘긴다)
LLM_BACKEND=fake

# OpenAI 모드를 사용하는 경우 본인의 API 키를 입력하세요.
OPENAI_API_KEY=
# OPENAI_FAST_MODEL=gpt-4o-mini
# OPENAI_QUALITY_MODEL=gpt-4o-mini
# OLLAMA_FAST_MODEL=qwen3:0.6b
# OLLAMA_QUALITY_MODEL=qwen3:8b

# LangSmith를 사용하지 않으면 false를 유지하세요.
LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=today-menu-agent

# 이유 문장 검증: off | rules | llm
# llm 은 실측에서 오탐이 많아 기본값에서 뺐다(옵션)
REVIEW_MODE=rules
# fake LLM 시나리오: normal | off_menu | bad_reason
FAKE_LLM_MODE=normal

# 그래프 체크포인터(승인 대기 상태): sqlite | memory
CHECKPOINTER=sqlite
# 기본값은 프로젝트 루트의 session.db / checkpoints.db
# MENU_DB_PATH=
# MENU_CHECKPOINT_DB=

# 메뉴 데이터 경로: mcp | local (local 이면 MCP subprocess 를 띄우지 않는다 — pytest 용)
MENU_REPO=mcp
# 1 이면 첫 list_menus 호출에 TimeoutError (재시도 데모)
MCP_FLAKY_FIRST_CALL=0
